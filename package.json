{
  "name": "menon-md",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal CV website for Rejeesh Menon, MD. Generated from a single cv.yaml source.",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/og-image.mjs",
    "build": "astro build && node scripts/verify-outputs.mjs && node scripts/scan-dist.mjs",
    "preview": "wrangler dev",
    "check": "astro check",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@astrojs/cloudflare": "^14.3.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.13.6",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.1"
  }
}
