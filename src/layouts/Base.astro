---
import '../styles/global.css';
import { cv } from '../lib/cv';
import { SITE, absoluteUrl } from '../lib/site';
import { buildJsonLd, jsonLdScript } from '../lib/jsonld';
import type { SectionDef } from '../lib/markdown';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ChatLauncher from '../components/ChatLauncher.astro';

interface Props {
  title: string;
  description: string;
  /** Path beginning with "/" used for the canonical URL. */
  path: string;
  noindex?: boolean;
  /** Include the Person JSON-LD graph (only on canonical CV pages). */
  jsonLd?: boolean;
  /** Sections to list in the sticky nav. Omit for no section nav. */
  navSections?: readonly SectionDef[];
  /** Audience slug passed to the chat so it can load jdContext. */
  audience?: string;
  /** Hide the floating chat launcher (used on /chat itself). */
  hideLauncher?: boolean;
}

const {
  title,
  description,
  path,
  noindex = false,
  jsonLd = false,
  navSections,
  audience,
  hideLauncher = false,
} = Astro.props;

const canonical = absoluteUrl(path);
const ogImage = absoluteUrl(SITE.ogImagePath);
const id = cv.identity;
const analyticsEnabled = !SITE.analyticsToken.startsWith('REPLACE_');
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={id.displayName} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1420" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Full CV as markdown" />
    <link rel="alternate" type="application/json" href="/cv.json" title="JSON Resume" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
    <meta property="og:image:alt" content={`${id.displayName}. ${id.headline}.`} />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content={id.givenName} />
    <meta property="profile:last_name" content={id.familyName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={jsonLdScript(buildJsonLd(cv))} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {navSections && <Nav sections={navSections} />}
    <slot />
    <Footer />
    {
      !hideLauncher && (
        <>
          <ChatLauncher audience={audience} />
          <script type="application/json" data-chat-starters set:html={JSON.stringify(cv.chat.starters)} />
        </>
      )
    }
    {
      analyticsEnabled && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.analyticsToken })}
        />
      )
    }
  </body>
</html>
