---
import DateRange from './DateRange.astro';

interface Props {
  title: string;
  organization: string;
  organizationUrl?: string | undefined;
  location: string;
  start: string;
  end?: string | undefined;
  bullets: readonly string[];
}
const { title, organization, organizationUrl, location, start, end, bullets } = Astro.props;
---

<article class="entry">
  <div class="entry-head">
    <h3>{title}</h3>
    <DateRange start={start} end={end} />
  </div>
  <p class="entry-meta">
    {organizationUrl ? <a href={organizationUrl} rel="noopener">{organization}</a> : organization}, {location}
  </p>
  <slot />
  {
    bullets.length > 0 && (
      <ul>
        {bullets.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    )
  }
</article>
